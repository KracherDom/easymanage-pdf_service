# Environment Variables - PDF Service
# Copy this file to .env and fill in your values

# Node.js
NODE_ENV=development
PORT=3001

# Supabase Configuration (for JWT verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://staging.easymanage.com,https://app.easymanage.com

# Optional: Railway-specific (set on Railway Dashboard, not in .env)
# RAILWAY_ENVIRONMENT=production
# RAILWAY_STATIC_URL=your-service.railway.app
